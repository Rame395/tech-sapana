datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  role      Role     @default(STUDENT)
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  enrollments Enrollment[]
}

enum Role {
  ADMIN
  STUDENT
}

model Course {
  id            String   @id @default(cuid())
  title         String
  slug          String   @unique
  description   String
  price         Float
  originalPrice Float?
  imageUrl      String?
  badgeText1    String?
  badge1Style   String?  @default("red")
  badgeText2    String?
  startDateText String?
  scheduleText  String?
  highlights    String[] // Array of strings for bullet points
  published     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  enrollments Enrollment[]
}

model Enrollment {
  id        String   @id @default(cuid())
  userId    String
  courseId  String
  createdAt DateTime @default(now())
  
  user      User     @relation(fields: [userId], references: [id])
  course    Course   @relation(fields: [courseId], references: [id])
  
  @@unique([userId, courseId])
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String?
  message   String
  createdAt DateTime @default(now())
  read      Boolean  @default(false)
}

model PromoBanner {
  id              String   @id @default("default")
  isActive        Boolean  @default(false)
  badgeText       String   @default("LIMITED TIME OFFER")
  title           String   @default("20% OFF THE WEEKEND CRASH COURSE.")
  targetDate      DateTime @default(now())
  buttonText      String   @default("Enroll Now")
  buttonLink      String   @default("/courses")
  marqueeIsActive Boolean  @default(true)
  marqueeText     String   @default("A leading tech institution in Nepal guiding students to global success")
  updatedAt       DateTime @updatedAt
}

model Project {
  id           String   @id @default(cuid())
  title        String
  slug         String   @unique
  description  String
  imageUrl     String?
  videoUrl     String?
  category     String   // e.g., "ecommerce", "hospitality", "management", "health"
  technologies String[]
  client       String?
  liveUrl      String?
  published    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}


model Faq {
  id        String   @id @default(cuid())
  question  String
  answer    String
  order     Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}



model Post {
  id              String   @id @default(cuid())
  title           String
  slug            String   @unique
  content         String
  status          String   @default("DRAFT") // DRAFT, PUBLISHED
  category        String?
  featuredImage   String?
  
  // SEO Fields
  focusKeyword    String?
  metaTitle       String?
  metaDescription String?
  noIndex         Boolean  @default(false)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}


model HeroSection {
  id               String   @id @default("default")
  badgeText        String   @default("WEB • SOFTWARE • AI SOLUTIONS")
  badgeSubText     String   @default("Turning Dreams Into Digital Reality")
  heading          String   @default("We Build Websites & Software That Move Your Business Forward.")
  description      String   @default("From high-converting websites to custom enterprise platforms, TechSapana designs and delivers digital products engineered for real revenue growth.")
  primaryBtnText   String   @default("Start Your Project")
  primaryBtnLink   String   @default("#contact")
  secondaryBtnText String   @default("Learn More About Us")
  secondaryBtnLink String   @default("#about")
  
  // Right side slider box text
  sliderBadge      String   @default("Web & Software Engineers")
  
  // Slides as JSON (array of { img, badge, title, subtitle })
  slides           Json     @default("[{\"img\":\"https://images.unsplash.com/photo-1522071820081-009f0129c71c?auto=format&fit=crop&w=900&q=80\",\"badge\":\"📡 Live Systems\",\"title\":\"Client Software & Web Engineering\",\"subtitle\":\"Kathmandu Development Studio\"}]")
  
  updatedAt        DateTime @updatedAt
}
